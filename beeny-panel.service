[Unit]
Description=Beeny Panel
After=network-online.target openvpn-server@server.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/beeny-panel
EnvironmentFile=/etc/beeny-panel/panel.env
ExecStart=/opt/beeny-panel/venv/bin/python /opt/beeny-panel/serve.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
