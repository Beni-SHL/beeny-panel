[Unit]
Description=Verified Beeny Panel daily backup
After=beeny-panel.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/beeny-panel
EnvironmentFile=/etc/beeny-panel/panel.env
Environment=PYTHONPATH=/opt/beeny-panel
ExecStart=/opt/beeny-panel/venv/bin/python /opt/beeny-panel/scripts/scheduled_backup.py
UMask=0077
Nice=10
