[Unit]
Description=Beeny Panel storage retention
After=beeny-panel.service
[Service]
Type=oneshot
User=beeny
Group=beeny
WorkingDirectory=/opt/beeny-panel
EnvironmentFile=/etc/beeny-panel/panel.env
ExecStart=/opt/beeny-panel/venv/bin/python /opt/beeny-panel/scripts/cleanup_storage.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/beeny-panel/instance
